# ── IoMarkets Topup — environment ─────────────────────────────────────────────
# Copy to .env. NEVER commit .env, mnemonics or keys.

NETWORK=mainnet                     # the GoPlausible facilitator currently serves mainnet only for `exact`
PORT=3000
PUBLIC_BASE_URL=https://iomarkets.app   # advertised to the Bazaar; MUST be the real public https origin

# Product name and home, used by every page, /agent.md, /llms.txt and the on-chain
# refund note. A rebrand is these two plus PUBLIC_BASE_URL — nothing else.
BRAND_NAME=IoMarkets Topup
BRAND_SITE=https://iomarkets.app

# x402 — Algorand USDC, settled by the GoPlausible facilitator (leaderboard + Bazaar)
PAY_TO=                              # 58-char Algorand address that receives USDC (opted in to ASA 31566704)
FACILITATOR_URL=https://facilitator.goplausible.xyz

# Receipt signing (pnpm gen-key). Publish RECEIPT_PUBLIC_KEY; it is served at /v1/pubkey.
RECEIPT_PRIVATE_KEY=
RECEIPT_PUBLIC_KEY=

# Supplier: mock | zendit | reloadly
# The supplier secrets buy real goods against our float. In production point
# ZENDIT_API_KEY_FILE / RELOADLY_CLIENT_SECRET_FILE at a root-owned 0400 file (or use a
# systemd credential) instead of setting the bare variable, which warns on boot.
SUPPLIER=mock
ZENDIT_API_KEY=
ZENDIT_BASE_URL=https://test-api.zendit.io/v1     # production: https://api.zendit.io/v1
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
RELOADLY_SANDBOX=true

# International payments (payouts): "" = off, mock = demo corridors (NG bank, KE M-Pesa, IN UPI, PH GCash, GE bank),
# bitnob = the live adapter (src/suppliers/bitnob.ts). Any other partner id hits the
# generic skeleton and throws on first use.
PAYOUT_SUPPLIER=
# Bitnob signs every request: client id + client secret, NOT a bearer token.
PAYOUT_CLIENT_ID=
# The partner secret moves money. In production point PAYOUT_API_KEY_FILE at a
# root-owned 0400 file (or use a systemd credential) rather than setting this.
PAYOUT_API_KEY=
PAYOUT_BASE_URL=            # blank = https://api.bitnob.com ; set the sandbox host while onboarding
PAYOUT_ASSET=USDC           # the stablecoin our partner float is held in
PAYOUT_CALLBACK_URL=        # optional partner webhook; we poll regardless
PAYOUT_MAX_SLIPPAGE_BPS=200 # refuse a partner quote delivering >2% less local currency than the offer priced
# Bill pay (type: "bill"). Empty hides the product. "reloadly" uses the Utilities API
# on the SAME credentials as airtime — Reloadly's OAuth audience names a product as
# well as an environment, so it just takes a different token.
#
# ⛔ 2026-09-01: Reloadly deprecated Utility Payments and asked us to stop calling the
# service. BILL_SUPPLIER=reloadly now THROWS at boot unless the line below is also set.
# Do not make the "one live test payment" the adapter's header used to ask for.
BILL_SUPPLIER=
ALLOW_DEPRECATED_BILL_SUPPLIER=   # set to 1 only after Reloadly confirms Utilities is back

# eSIMs (type: "esim"). Empty routes them to the goods supplier — which sells none, because
# Reloadly has no eSIM product at all. Three real options, all USD-priced:
#   esimaccess  self-serve access code, NO minimum order quantity, and the only one with an
#               idempotency key + an order lookup + a balance endpoint. Start here.
#   airalo      bigger catalogue, but aimed at high-volume partners
#               (2026-09-02) — a volume floor we do not meet, and no order lookup or balance.
#   zendit      reuses the SUPPLIER=zendit credentials (sandbox-proven, needs a live key).
# Each slot gets its own float: an eSIM bought from Zendit does not spend Reloadly's airtime
# balance, and quote() checks the right one.
ESIM_SUPPLIER=
# eSIM Access. The access code is BOTH the identifier and the HMAC signing key, so treat it
# as a full credential — file or systemd credential, never a bare env var in production.
# There is no sandbox: the first order is live money. `pnpm check-esim` is read-only.
ESIMACCESS_ACCESS_CODE_FILE=      # 0400 file; ESIMACCESS_ACCESS_CODE works in dev and warns
# Optional. Their published API reference signs with the access code itself; their console
# also issues a secret key. Set this and requests are signed with it instead. If auth fails
# with 401001, try it with and without — `pnpm check-esim` answers in one call either way.
ESIMACCESS_SECRET_KEY_FILE=       # 0400 file; ESIMACCESS_SECRET_KEY works in dev and warns
ESIMACCESS_BASE_URL=              # default https://api.esimaccess.com/api/v1/open
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET_FILE=        # 0400 file; AIRALO_CLIENT_SECRET works in dev and warns
PAYOUT_MAX_USD=200          # per payment
PAYOUT_KYC_ABOVE_USD=100    # per payer per UTC day; above this a partner KYC reference is required on the quote

# Pricing: price = cost × (1 + MARKUP_BPS/10000) + FIXED_FEE_USD, rounded up to the cent, floor MIN_ORDER_USD
MARKUP_BPS=400
# Per-type override: MARKUP_BPS_BY_TYPE="esim=700". 400 bps was chosen when airtime was the
# only product — a buyer prices a top-up against the operator's own app in seconds, so the
# markup has to be thin. An eSIM has no face value to compare against and an $8-30 ticket,
# where 600-800 bps is the researched range . Empty = one markup for
# everything, which is what shipped. A typo here is fatal at boot rather than quiet in a quote.
MARKUP_BPS_BY_TYPE=
# What a dollar of supplier float actually COSTS, in bps over face value — measured from a
# real deposit, never assumed. A $50 card deposit landing as $47.75 of credit is 471 bps.
# 0 is honest only when the supplier is funded in the asset we already hold (USDC).
# preflight does the arithmetic and says whether MARKUP_BPS covers it.
FLOAT_ACQUISITION_BPS=0
FIXED_FEE_USD=0.05
MIN_ORDER_USD=0.5
# How far MIN_ORDER_USD may inflate a price before the offer is refused as unsellable.
# 2 (default) lets the floor double a price; 1 means every listed price comes from the markup
# and never from the floor. Production runs 1 since 2026-09-02 — it delists ~2.5% of the eSIM
# catalogue (everything costing under ~$0.39) and the fixed NG airtime bundles that printed a
# local amount next to a floored price. See floorInflatesPrice() in src/money.ts.
MAX_FLOOR_MULTIPLE=10

# Abuse / AML posture
MAX_ORDER_USD=50
# Per-product-type per-order caps, "<type>=<usd>,…". Lowers MAX_ORDER_USD for those
# types only; it can never raise it, and only a KYB'd business account with a
# hand-set per-order ceiling overrides one. A malformed value stops the process at
# boot rather than quietly leaving the ceiling off.
# Empty: airtime lands on one phone number, a bill goes to one meter, and a payout has
# a named sender and a sanctions check — none of them is a bearer instrument. This is
# here for the next product that is.
TYPE_MAX_USD=
PAYER_DAILY_USD=200
QUOTE_TTL_SEC=600
FREE_ROUTE_PER_MINUTE=60
# ⛔ Sanctioned countries are hard-coded in src/sanctions.ts and cannot be removed here.
# This only ADDS codes on top of that list. Leave empty unless adding.
BLOCKED_COUNTRIES=

# Refund hot wallet — SEPARATE account, small USDC float, opted in to USDC (pnpm optin).
# NEVER put the mnemonic here. Point at a root-owned 0400 file, or use a systemd
# encrypted credential named "refund-mnemonic" . KMS signer = upgrade path.
REFUND_MNEMONIC_FILE=/etc/iomarkets/refund.mnemonic
REFUND_DAILY_CAP_USD=100

# Referral share (src/referrals.ts). 0 = off, and shipping the code moves no money.
# A share of NET margin (price − cost − FLOAT_ACQUISITION_BPS), paid on DELIVERED orders only, from the refund
# hot wallet — which a referral payout never takes below REFERRAL_REFUND_RESERVE_USD. Refunds come first.
REFERRAL_SHARE_BPS=0
REFERRAL_MIN_PAYOUT_USD=1
REFERRAL_DAILY_CAP_USD=25
REFERRAL_REFUND_RESERVE_USD=20

# Fulfilment polling
FULFIL_POLL_MS=3000
FULFIL_TIMEOUT_MS=600000

DB_PATH=./data/iomarkets-app.db

# Buyer-side (scripts/buy.ts, MCP server) — a funded wallet the agent pays FROM. Same rule: a file, not here.
AGENT_MNEMONIC_FILE=~/.secrets/agent.mnemonic
API_URL=http://127.0.0.1:3000
BUY_BUDGET_USD=25
